rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function eventMember(eventId) {
      return signedIn() && (
        get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid ||
        exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid))
      );
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);
      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    match /telegramConnections/{uid} {
      allow read, write: if false;
    }

    match /telegramLinkTokens/{id} {
      allow read, write: if false;
    }

    match /friends/{id} {
      allow read: if signedIn() && (resource.data.userA == request.auth.uid || resource.data.userB == request.auth.uid);
      allow write: if false;
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow write: if false;
    }

    match /userEvents/{uid}/items/{eventId} {
      allow read: if isMe(uid);
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.organizerId == request.auth.uid ||
        exists(/databases/$(database)/documents/events/$(eventId)/participants/$(request.auth.uid))
      );
      allow write: if false;

      match /participants/{uid} {
        allow read: if eventMember(eventId);
        allow write: if false;
      }

      match /messages/{messageId} {
        allow read: if eventMember(eventId);
        allow create: if eventMember(eventId)
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1500;
        allow delete: if eventMember(eventId) && resource.data.userId == request.auth.uid;
        allow update: if false;
      }

      match /polls/{pollId} {
        allow read: if eventMember(eventId);
        allow write: if false;
        match /votes/{uid} {
          allow read: if eventMember(eventId);
          allow write: if false;
        }
      }

      match /expenses/{expenseId} {
        allow read: if eventMember(eventId);
        allow write: if false;
      }

      match /teams/{teamId} {
        allow read: if eventMember(eventId);
        allow write: if false;
      }

      match /mvpVotes/{uid} {
        allow read: if eventMember(eventId);
        allow write: if false;
      }

      match /gallery/{itemId} {
        allow read: if eventMember(eventId);
        allow write: if false;
      }
    }

    match /eventReminders/{id} {
      allow read, write: if false;
    }

    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
